# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > 웹 앱의 firebaseConfig 값을 넣으세요.
# 이 값들은 브라우저에 노출되는 공개 식별자입니다(비밀키 아님).
# 실제 보안은 Firestore 보안 규칙 + Firebase Auth가 담당합니다.
# 이 파일을 client/.env 로 복사한 뒤 값을 채우세요.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
