rules_version = '2';

// 이 앱은 브라우저가 Firestore에 직접 접근하지 않는다.
// 모든 읽기/쓰기는 Express 서버가 Admin SDK로 수행하며, Admin SDK는 보안 규칙을 우회한다.
// 따라서 클라이언트 직접 접근은 전부 막아두는 것이 맞다.
//
// 나중에 클라이언트 직접 접근이 필요해지면 컬렉션별 규칙을 여기에 추가할 것.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
